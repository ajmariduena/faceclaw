<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- theme to use FOR launch screen-->
    <style name="LaunchScreenThemeBase" parent="Theme.AppCompat.NoActionBar">
        <item name="toolbarStyle">@style/NativeScriptToolbarStyle</item>

        <item name="colorPrimary">@color/ns_primary</item>
        <item name="colorPrimaryDark">@color/ns_primaryDark</item>
        <item name="colorAccent">@color/ns_accent</item>

        <item name="android:windowBackground">@drawable/splash_screen</item>

        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="LaunchScreenTheme" parent="LaunchScreenThemeBase">
    </style>

    <!-- theme to use AFTER launch screen is loaded-->
    <style name="AppThemeBase" parent="Theme.AppCompat.NoActionBar">
        <item name="toolbarStyle">@style/NativeScriptToolbarStyle</item>

        <item name="colorPrimary">@color/ns_primary</item>
        <item name="colorPrimaryDark">@color/ns_primaryDark</item>
        <item name="colorAccent">@color/ns_accent</item>
        <item name="alertDialogTheme">@style/FaceclawAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/FaceclawPlatformAlertDialogTheme</item>

        <!-- NativeScript builds the toolbar programmatically, so tint the
             overflow button itself to match the black toolbar. -->
        <item name="actionOverflowButtonStyle">@style/FaceclawOverflowButtonStyle</item>
    </style>

    <style name="FaceclawOverflowButtonStyle" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">#FFFFFF</item>
    </style>

    <style name="FaceclawAlertDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/faceclaw_dialog_background</item>
        <item name="android:textColorPrimary">#F2F2F2</item>
        <item name="android:textColorSecondary">#9A9A9A</item>
        <item name="colorAccent">#F2F2F2</item>
    </style>

    <!-- NativeScript Dialogs uses android.app.AlertDialog, which reads the
         platform attribute rather than AppCompat's alertDialogTheme. -->
    <style name="FaceclawPlatformAlertDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/faceclaw_dialog_background</item>
        <item name="android:textColorPrimary">#F2F2F2</item>
        <item name="android:textColorSecondary">#9A9A9A</item>
        <item name="android:colorAccent">#F2F2F2</item>
    </style>

    <style name="AppTheme" parent="AppThemeBase">
    </style>

    <!-- theme for action-bar -->
    <style name="NativeScriptToolbarStyleBase" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">#000000</item>
        <item name="theme">@style/NativeScriptToolbarTheme</item>
        <item name="popupTheme">@style/NativeScriptToolbarPopupTheme</item>
    </style>

    <style name="NativeScriptToolbarStyle" parent="NativeScriptToolbarStyleBase">
    </style>

    <style name="NativeScriptToolbarTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="actionMenuTextColor">#FFFFFF</item>
    </style>

    <style name="NativeScriptToolbarPopupTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:colorBackground">#151515</item>
        <item name="android:textColorPrimary">#F2F2F2</item>
        <item name="android:textColorSecondary">#9A9A9A</item>
        <item name="colorControlNormal">#F2F2F2</item>
    </style>
</resources>
