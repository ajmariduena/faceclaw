<Page xmlns="http://schemas.nativescript.org/tns.xsd" class="fc-page" navigatingTo="navigatingTo" unloaded="unloaded">
    <ActionBar class="fc-action-bar" title="Ask about conversations" />

    <GridLayout rows="auto,auto,auto,*" class="fc-body">
        <TextField
            row="0"
            hint="e.g. What did Alice say about the budget last week?"
            text="{{ question }}"
            returnKeyType="go"
            returnPress="{{ onAskTap }}" class="fc-address-input" />
        <Button row="1" text="{{ askLabel }}" tap="{{ onAskTap }}" isEnabled="{{ askEnabled }}" class="fc-primary-button" />
        <Label row="2" text="{{ statusText }}" class="conversation-meta m-t-4" textWrap="true" visibility="{{ statusVisibility }}" />
        <ScrollView row="3" class="fc-ask-results">
            <StackLayout>
                <Label text="{{ answer }}" class="ask-answer" textWrap="true" visibility="{{ answerVisibility }}" />
                <Label text="{{ contextNote }}" class="conversation-meta m-t-8" textWrap="true" visibility="{{ noteVisibility }}" />
            </StackLayout>
        </ScrollView>
    </GridLayout>
</Page>
