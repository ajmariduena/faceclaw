<Page xmlns="http://schemas.nativescript.org/tns.xsd" xmlns:rc="phone-ui" navigatingTo="navigatingTo" class="fc-page">
  <ActionBar title="API keys" class="fc-action-bar">
    <NavigationButton android.systemIcon="ic_menu_back" tap="{{ onBackTap }}" />
    <!-- Action view, not text: Android menu-item text takes the (unapplied) toolbar theme's colour and vanishes on the black bar. -->
    <ActionItem tap="{{ testAll }}" android.position="actionBar">
      <Label text="{{ testAllLabel }}" class="fc-bar-action" />
    </ActionItem>
  </ActionBar>
  <ScrollView>
    <rc:settings-groups class="fc-body" />
  </ScrollView>
</Page>
