<Page xmlns="http://schemas.nativescript.org/tns.xsd" class="fc-page" navigatingTo="navigatingTo">
    <ActionBar class="fc-action-bar" title="Conversations">
        <ActionItem tap="{{ onAskTap }}" android.position="actionBar">
            <Label text="Ask AI" class="fc-bar-action" />
        </ActionItem>
        <ActionItem tap="{{ onSpeakersTap }}" android.position="actionBar">
            <Label text="Speakers" class="fc-bar-action" />
        </ActionItem>
    </ActionBar>

    <GridLayout rows="auto,auto,*" class="fc-body">
        <GridLayout row="0" columns="*,auto" class="fc-conversation-search">
            <TextField col="0" hint="Search conversations" text="{{ searchText }}" returnKeyType="search" returnPress="{{ onSearchSubmit }}" class="fc-conversation-search-input" />
            <Label col="1" text="×" tap="{{ onSearchClear }}" accessibilityLabel="Clear search" class="fc-conversation-search-clear" verticalAlignment="center" />
        </GridLayout>

        <ScrollView row="1" orientation="horizontal" class="m-t-8" visibility="{{ filterChipsVisibility }}">
            <StackLayout orientation="horizontal">
                <Repeater items="{{ speakerChips }}">
                    <Repeater.itemsLayout>
                        <StackLayout orientation="horizontal" />
                    </Repeater.itemsLayout>
                    <Repeater.itemTemplate>
                        <Label text="{{ name }}" class="{{ chipClass }}" tap="{{ onChipTap }}" />
                    </Repeater.itemTemplate>
                </Repeater>
            </StackLayout>
        </ScrollView>

        <ScrollView row="2" class="m-t-8 fc-conversation-results" loaded="{{ onResultsLoaded }}">
            <StackLayout>
                <Label text="{{ emptyMessage }}" class="conversation-empty" textWrap="true" visibility="{{ emptyVisibility }}" />
                <Repeater items="{{ sessionRows }}">
                    <Repeater.itemsLayout>
                        <StackLayout />
                    </Repeater.itemsLayout>
                    <Repeater.itemTemplate>
                        <StackLayout class="conversation-row" tap="{{ onRowTap }}">
                            <GridLayout columns="*,auto">
                                <Label col="0" text="{{ title }}" class="conversation-title" textWrap="true" />
                                <Label col="1" text="" width="12" height="12" borderRadius="6" backgroundColor="{{ sentimentColor }}" verticalAlignment="center" />
                            </GridLayout>
                            <Label text="{{ meta }}" class="conversation-meta" />
                            <Repeater items="{{ speakerChips }}" visibility="{{ chipsVisibility }}" class="m-t-4">
                                <Repeater.itemsLayout>
                                    <WrapLayout />
                                </Repeater.itemsLayout>
                                <Repeater.itemTemplate>
                                    <Label text="{{ name }}" class="speaker-chip" />
                                </Repeater.itemTemplate>
                            </Repeater>
                        </StackLayout>
                    </Repeater.itemTemplate>
                </Repeater>
            </StackLayout>
        </ScrollView>
    </GridLayout>
</Page>
