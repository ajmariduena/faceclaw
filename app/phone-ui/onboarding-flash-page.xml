<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" navigatingFrom="navigatingFrom" enableSwipeBackNavigation="false" actionBarHidden="true" class="fc-page">
    <GridLayout rows="*,auto" class="fc-flow">
        <ScrollView row="0">
            <StackLayout class="fc-flow-content">
                <Label text="{{ headline }}" class="fc-flow-title" textWrap="true" />
                <ActivityIndicator busy="{{ busy }}" visibility="{{ busyVisibility }}" class="fc-flow-progress" />
                <Progress value="{{ progress }}" maxValue="100" visibility="{{ progressVisibility }}" class="fc-flow-progress" />
                <Label text="{{ status }}" class="fc-flow-card-text" textWrap="true" />
                <Label text="{{ log }}" class="fc-flow-log" textWrap="true" visibility="{{ logVisibility }}" />
            </StackLayout>
        </ScrollView>

        <GridLayout row="1" columns="*,*" class="fc-flow-actions">
            <Button col="0" text="{{ secondaryLabel }}" tap="{{ onSecondaryTap }}" visibility="{{ secondaryVisibility }}" class="fc-secondary-button" />
            <Button col="1" text="{{ primaryLabel }}" tap="{{ onPrimaryTap }}" visibility="{{ primaryVisibility }}" class="fc-primary-button" />
        </GridLayout>
    </GridLayout>
</Page>
