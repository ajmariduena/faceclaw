<Page xmlns="http://schemas.nativescript.org/tns.xsd" xmlns:rc="phone-ui" navigatingTo="navigatingTo" loaded="loaded" unloaded="unloaded" class="fc-page">
    <ActionBar class="fc-action-bar">
        <GridLayout columns="auto,*,auto,auto,auto" width="100%" verticalAlignment="center">
            <Label col="0" text="Faceclaw" class="action-bar-title" />
            <Image col="2" src="{{ evenHubPhoneUiIcon }}" tap="{{ onEvenHubPhoneUiTap }}" visibility="{{ evenHubPhoneUiVisibility }}" class="action-bar-app-icon" />
            <Label col="3" text="{{ connectionStatusLabel }}" tap="{{ onConnectionStatusTap }}" visibility="{{ landscapeLayoutVisibility }}" class="action-bar-status" />
            <Label col="4" text="&#x26A0;&#xFE0F;" tap="{{ onWarningIconTap }}" visibility="{{ warningIconVisibility }}" class="action-bar-warning" />
        </GridLayout>
        <ActionItem text="{{ buttonLabel }}" tap="{{ onTap }}" isEnabled="{{ connectItemEnabled }}" visibility="{{ glassesMenuItemsVisibility }}" android.position="popup" />
        <ActionItem text="Take screenshot" tap="{{ onTakeScreenshotTap }}" android.position="popup" />
        <ActionItem text="Record screen" tap="{{ onRecordScreenTap }}" android.position="popup" />
    </ActionBar>

    <GridLayout>
        <GridLayout rows="*,auto" visibility="{{ portraitLayoutVisibility }}">
            <ScrollView row="0">
                <StackLayout class="fc-body">
                    <StackLayout class="fc-hero">
                        <Image src="{{ glassesImage }}" stretch="aspectFit" class="fc-hero-image" />
                        <Label text="{{ glassesName }}" class="fc-hero-name" />
                        <Label text="{{ glassesState }}" tap="{{ onConnectionStatusTap }}" class="fc-hero-state" />
                    </StackLayout>
                    <GridLayout class="fc-mirror" height="{{ homePreviewHeight }}">
                        <Image src="{{ displayPreview }}" stretch="fill" visibility="{{ displayPreviewVisibility }}"
                            tap="{{ onMirrorTap }}" doubleTap="{{ onMirrorDoubleTap }}" longPress="{{ onMirrorLongPress }}" swipe="{{ onMirrorSwipe }}" />
                        <Label text="{{ displayPreviewMessage }}" textWrap="true" class="fc-mirror-message" horizontalAlignment="center" verticalAlignment="center" visibility="{{ displayPreviewMessageVisibility }}" />
                    </GridLayout>
                    <StackLayout class="fc-card fc-card-spaced">
                        <GridLayout columns="*,auto,auto" rows="auto" class="fc-row fc-row-first" tap="{{ onDisplaySectionTap }}">
                            <Label col="0" text="Display" class="fc-row-label" verticalAlignment="center" />
                            <Label col="2" text="›" class="fc-chevron" verticalAlignment="center" />
                        </GridLayout>
                        <GridLayout columns="*,auto,auto" rows="auto" class="fc-row" tap="{{ onControlsSectionTap }}">
                            <Label col="0" text="Controls" class="fc-row-label" verticalAlignment="center" />
                            <Label col="1" text="{{ controlsSummary }}" class="fc-row-value" verticalAlignment="center" />
                            <Label col="2" text="›" class="fc-chevron" verticalAlignment="center" />
                        </GridLayout>
                        <GridLayout columns="*,auto,auto" rows="auto" class="fc-row" tap="{{ onVoiceSectionTap }}">
                            <Label col="0" text="Voice &amp; bots" class="fc-row-label" verticalAlignment="center" />
                            <Label col="2" text="›" class="fc-chevron" verticalAlignment="center" />
                        </GridLayout>
                        <GridLayout columns="*,auto,auto" rows="auto" class="fc-row" tap="{{ onApiKeysTap }}">
                            <Label col="0" text="API keys" class="fc-row-label" verticalAlignment="center" />
                            <Label col="2" text="›" class="fc-chevron" verticalAlignment="center" />
                        </GridLayout>
                        <GridLayout columns="*,auto,auto" rows="auto" class="fc-row" tap="{{ onConversationsTap }}">
                            <Label col="0" text="Conversations" class="fc-row-label" verticalAlignment="center" />
                            <Label col="2" text="›" class="fc-chevron" verticalAlignment="center" />
                        </GridLayout>
                        <GridLayout columns="*,auto,auto" rows="auto" class="fc-row" tap="{{ onDeviceSectionTap }}">
                            <Label col="0" text="Device" class="fc-row-label" verticalAlignment="center" />
                            <Label col="2" text="›" class="fc-chevron" verticalAlignment="center" />
                        </GridLayout>
                        <GridLayout columns="*,auto,auto" rows="auto" class="fc-row" tap="{{ onAboutSectionTap }}">
                            <Label col="0" text="About" class="fc-row-label" verticalAlignment="center" />
                            <Label col="1" text="{{ versionLabel }}" class="fc-row-value" verticalAlignment="center" />
                            <Label col="2" text="›" class="fc-chevron" verticalAlignment="center" />
                        </GridLayout>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <Button row="1" text="Stop recording" tap="{{ onStopRecordingTap }}" visibility="{{ stopRecordingButtonVisibility }}" class="fc-button" />
        </GridLayout>

        <GridLayout class="landscape-layout" visibility="{{ landscapeLayoutVisibility }}">
            <GridLayout rows="*" columns="*,345">
                <GridLayout col="0" layoutChanged="{{ onLandscapePreviewLayoutChanged }}">
                    <StackLayout visibility="{{ displayPreviewVisibility }}" horizontalAlignment="left" verticalAlignment="center">
                        <Image
                            src="{{ displayPreview }}"
                            stretch="fill"
                            width="{{ landscapeDisplayPreviewWidth }}"
                            height="{{ landscapeDisplayPreviewHeight }}"
                            tap="{{ onMirrorTap }}" doubleTap="{{ onMirrorDoubleTap }}" longPress="{{ onMirrorLongPress }}" swipe="{{ onMirrorSwipe }}" />
                    </StackLayout>
                    <GridLayout
                        class="display-preview-message"
                        horizontalAlignment="left"
                        verticalAlignment="center"
                        width="{{ landscapeDisplayPreviewWidth }}"
                        height="{{ landscapeDisplayPreviewHeight }}"
                        visibility="{{ displayPreviewMessageVisibility }}">
                        <Label text="{{ displayPreviewMessage }}" textWrap="true" horizontalAlignment="center" verticalAlignment="center" />
                    </GridLayout>
                </GridLayout>
                <GridLayout col="1" rows="*,auto">
                    <rc:remote-controls row="0" visibility="{{ controlsVisibility }}" />
                    <Button row="1" text="Stop recording" tap="{{ onStopRecordingTap }}" visibility="{{ stopRecordingButtonVisibility }}" />
                </GridLayout>
            </GridLayout>
        </GridLayout>
        <!-- Developer BLE-bandwidth indicator: overlays the bottom edge of the
             page in both orientations, on every tab. -->
        <Label
            text="{{ bleBandwidthLabel }}"
            visibility="{{ bleBandwidthVisibility }}"
            class="ble-bandwidth-indicator"
            horizontalAlignment="center"
            verticalAlignment="bottom" />
        <ScrollView
            class="warnings-modal"
            visibility="{{ warningsModalVisibility }}"
            width="{{ warningsModalWidth }}"
            horizontalAlignment="center"
            verticalAlignment="center">
            <StackLayout class="warnings-modal-content">
                <Label text="Attention needed" class="h2" />
                <StackLayout visibility="{{ evenAppConflictWarningVisibility }}" class="warnings-modal-item">
                    <Label text="{{ evenAppConflictMessage }}" textWrap="true" />
                    <Button text="Open Even app settings" tap="{{ onOpenEvenAppSettingsTap }}" class="-primary" />
                </StackLayout>
                <StackLayout visibility="{{ firmwareWarningVisibility }}" class="warnings-modal-item">
                    <Label text="{{ firmwareWarningMessage }}" textWrap="true" />
                    <Button text="Install custom firmware" tap="{{ onInstallFirmwareTap }}" class="-primary" />
                </StackLayout>
                <StackLayout visibility="{{ batteryOptimizationWarningVisibility }}" class="warnings-modal-item">
                    <Label text="Android will slow Faceclaw to a crawl when the phone screen is off unless it is exempt from battery optimization." textWrap="true" />
                    <Button text="Allow unrestricted background usage" tap="{{ onAllowBackgroundUsageTap }}" class="-primary" />
                </StackLayout>
                <StackLayout visibility="{{ fontsMissingWarningVisibility }}" class="warnings-modal-item">
                    <Label text="The G2 fonts have not been extracted, so EvenHub apps will render with fallback fonts. Preparing them downloads the official firmware to extract its fonts; your glasses are not reflashed." textWrap="true" />
                    <Button text="Prepare G2 fonts" tap="{{ onPrepareFontsTap }}" class="-primary" />
                </StackLayout>
                <StackLayout visibility="{{ alarmReliabilityWarningVisibility }}" class="warnings-modal-item">
                    <Label text="{{ alarmReliabilityMessage }}" textWrap="true" />
                    <Button text="Open phone settings" tap="{{ onFixAlarmReliabilityTap }}" class="-primary" />
                </StackLayout>
                <Button text="Close" tap="{{ onWarningsModalCloseTap }}" />
            </StackLayout>
        </ScrollView>
        <rc:text-setting-editor />
        <!-- Keyboard-input panel (the keyboard button beside the mic button):
             the phone's end of the keyboard dialog on the glasses
             (ui/shell/keyboard-input.ts). Same placement and collapsing rules
             as the setting editor above. Enter inserts a newline; the send
             buttons pick a destination directly. -->
        <rc:keyboard-input-panel />
    </GridLayout>
</Page>
