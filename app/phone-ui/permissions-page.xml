<Page xmlns="http://schemas.nativescript.org/tns.xsd" class="fc-page" navigatingTo="navigatingTo" loaded="loaded" unloaded="unloaded" actionBarHidden="{{ actionBarHidden }}">
    <ActionBar class="fc-action-bar" title="Permissions" />

    <GridLayout rows="auto,*,auto" class="fc-flow">
        <StackLayout row="0" class="fc-flow-content">
            <Label text="Permissions" class="fc-flow-title" textWrap="true" visibility="{{ headlineVisibility }}" />
            <Label text="{{ instructions }}" class="fc-flow-note" textWrap="true" />
        </StackLayout>

        <ScrollView row="1">
            <StackLayout>
                <Repeater items="{{ cards }}">
                    <Repeater.itemsLayout>
                        <StackLayout />
                    </Repeater.itemsLayout>
                    <Repeater.itemTemplate>
                        <GridLayout columns="*,auto" rows="auto" class="pairing-row" tap="{{ onCardTap }}">
                            <StackLayout col="0">
                                <GridLayout columns="auto,auto">
                                    <Label col="0" text="{{ title }}" class="pairing-title" />
                                    <Label col="1" text="Optional" class="pairing-badge" marginLeft="14" visibility="{{ optionalVisibility }}" />
                                </GridLayout>
                                <Label text="{{ description }}" class="permissions-description" textWrap="true" />
                            </StackLayout>
                            <Label col="1" text="✓" class="permissions-check" verticalAlignment="center" visibility="{{ checkVisibility }}" />
                        </GridLayout>
                    </Repeater.itemTemplate>
                </Repeater>
            </StackLayout>
        </ScrollView>

        <GridLayout row="2" columns="*,*" class="fc-flow-actions">
            <Button col="0" text="Back" tap="{{ onSecondaryTap }}" visibility="{{ secondaryVisibility }}" class="fc-secondary-button" />
            <Button col="1" text="{{ primaryLabel }}" tap="{{ onPrimaryTap }}" class="{{ primaryClass }}" />
        </GridLayout>
    </GridLayout>
</Page>
