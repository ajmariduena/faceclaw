<Page xmlns="http://schemas.nativescript.org/tns.xsd" class="fc-page" navigatingTo="navigatingTo">
    <ActionBar class="fc-action-bar" title="{{ title }}">
        <NavigationButton android.systemIcon="ic_menu_back" tap="{{ onBackTap }}" />
    </ActionBar>

    <ScrollView>
        <Label text="{{ text }}" textWrap="true" class="document-text p-16" />
    </ScrollView>
</Page>
