<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" navigatingFrom="navigatingFrom" actionBarHidden="true" class="fc-page">
    <GridLayout rows="*,auto" class="fc-flow">
        <ScrollView row="0">
            <StackLayout class="fc-flow-content">
                <Label text="{{ headline }}" class="fc-flow-title" textWrap="true" />
                <ActivityIndicator busy="{{ busy }}" visibility="{{ busyVisibility }}" class="fc-flow-progress" />
                <Label text="{{ status }}" class="fc-flow-card-text" textWrap="true" />
            </StackLayout>
        </ScrollView>

        <StackLayout row="1" class="fc-flow-actions">
            <!-- Error-only escape hatches: flash anyway, or trust that the custom firmware is present. -->
            <GridLayout columns="*,*" visibility="{{ errorActionsVisibility }}">
                <Button col="0" text="Install" tap="{{ onInstallTap }}" class="fc-secondary-button" />
                <Button col="1" text="Skip" tap="{{ onSkipTap }}" class="fc-secondary-button" />
            </GridLayout>
            <GridLayout columns="*,*">
                <Button col="0" text="{{ secondaryLabel }}" tap="{{ onSecondaryTap }}" visibility="{{ secondaryVisibility }}" class="fc-secondary-button" />
                <Button col="1" text="{{ primaryLabel }}" tap="{{ onPrimaryTap }}" visibility="{{ primaryVisibility }}" class="fc-primary-button" />
            </GridLayout>
        </StackLayout>
    </GridLayout>
</Page>
